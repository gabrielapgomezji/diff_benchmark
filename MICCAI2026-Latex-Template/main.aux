\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Combined analysis of model-family performance and preprocessing sensitivity across four tasks using a normalized score (dummy baseline = 0, perfect performance = 1), enabling comparison across heterogeneous evaluation metrics. Left: Cross-validation performance of individual runs grouped by model family. Points denote fold-averaged scores per model; violins illustrate the distribution within each family; diamonds indicate medians. Horizontal lines mark the median performance of the linear baseline for each dataset–task. Right: Sensitivity to preprocessing strategy, aggregating across models and grouping by feature × tissue configurations. Each dot corresponds to a specific preprocessing strategy; vertical bars indicate the interquartile range (IQR) and overall spread across strategies. Variability induced by preprocessing is often comparable to, or larger than, differences between model families.}}{6}{}\protected@file@percent }
\newlabel{fig:model_family}{{2}{6}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Fold-level paired comparison of white versus gray matter performance using normalized scores (dummy baseline = 0, perfect performance = 1). Each point represents a matched fold-specific difference ($\Delta = {white} - {gray}$) under identical dataset–target–task–feature conditions. Left: dataset-level tissue effects after removing feature-specific baseline offsets. Right: feature-level tissue effects after removing dataset–task baseline offsets. Boxplots summarize the distribution of fold-level differences, and p-values are computed from configuration-level mean effects tested against zero. Positive values indicate white matter superiority; negative values indicate gray matter superiority.}}{7}{}\protected@file@percent }
\newlabel{fig:white_vs_gray}{{3}{7}{}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Impact of tissue type}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Proportion of models exhibiting consistent performance improvement over the non-diffusion baseline (b0), stratified by dataset–task and microstructural feature. Improvement is evaluated relative to fold-level normalized scores ($\Delta = {feature} - b0$). Left: statistical criterion (one-sample t-test against zero on fold-level deltas; p < 0.05 and mean $\Delta > 0$). Right: robustness criterion (median $\Delta \ge 0.03$ and ≥ 80\% of folds positive). Each cell reports the fraction of models satisfying the corresponding criterion (numerator/total models). Rows correspond to dataset–target combinations; columns correspond to diffusion-derived features.}}{8}{}\protected@file@percent }
\newlabel{fig:feature_impact}{{4}{8}{}{figure.4}{}}
